# Ignore everything by default (small build context)
**

# Keep docker files at repo root
!Dockerfile*
!docker-compose*.yml
!.dockerignore

# Keep only the application folder used by Dockerfile.simplified
!gbp-main/**

# Exclude heavy/generated content inside gbp-main
gbp-main/node_modules
gbp-main/node_modules/**
gbp-main/dist
gbp-main/dist/**
!gbp-main/dist
!gbp-main/dist/**
gbp-main/build
gbp-main/build/**
gbp-main/.cache
gbp-main/.cache/**
gbp-main/coverage
gbp-main/coverage/**

# Exclude local env/secrets
gbp-main/.env
gbp-main/.env.*
